{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/api/*"]
  },
  "routes": [
    {
      "route": "/*",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      }
    }
  ],
  "globalHeaders": {
    "Cache-Control": "public, max-age=600"
  },
  "mimeTypes": {
    ".json": "application/json; charset=utf-8"
  }
}
