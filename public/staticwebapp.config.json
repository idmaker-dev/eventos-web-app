{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "*.css",
      "*.js",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.svg",
      "*.webp",
      "*.ico",
      "*.json",
      "*.txt",
      "/assets/*",
      "/static/*",
      "/api/*"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
